# ==============================================================================
# Environment Configuration
# Copy this file to .env and fill in local or cloud credentials.
# ==============================================================================

# PostgreSQL OLTP Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=marketplace_oltp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Kafka & Debezium
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081
DEBEZIUM_CONNECT_URL=http://localhost:8083

# Databricks Community Edition
DATABRICKS_HOST=https://community.cloud.databricks.com
DATABRICKS_TOKEN=your_databricks_personal_access_token_here
DATABRICKS_CLUSTER_ID=

# GCP / BigQuery (Optional / Cloud phase)
GCP_PROJECT_ID=
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=

# Airflow
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
